{
  "name": "threejs-journey-exercise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf node_modules dist",
    "dev": "vite",
    "format": "prettier --list-different --write '*.{js,ts,json,md}' 'src/**/*.{css,js,jsx,ts,tsx,json,md}'",
    "typecheck": "tsc --noEmit"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "vite-plugin-restart>vite": "8"
      }
    }
  },
  "dependencies": {
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/three": "^0.183.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-restart": "^2.0.0"
  }
}
